# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# audio sinh bằng edge-tts từ scripts/out/audio-*.json (1.6GB, 63k mp3) — sinh lại:
#   python3 scripts/build-audio.py out/audio-words.json     ../public/audio/words
#   python3 scripts/build-audio.py out/audio-sentences.json ../public/audio/sentences
/public/audio/

# cache & kết quả test, log của scripts/deploy.sh
/.firebase/
/scripts/.deploy.log
/scripts/.build.log
/test-results/
/playwright-report/

# học liệu: venv TTS, cache TTS từng lượt thoại, mốc thời gian audio (sinh lại bằng npm run content:build),
# checkpoint tạm khi sản xuất nội dung hàng loạt
/scripts/.venv-tts/
/scripts/.video-tts-cache/
/scripts/.content-audio/
/.english-content-state.json
# tiến độ đợt bài đọc/truyện từ nguồn mở + câu hỏi đọc hiểu (ghi chú làm việc, không commit)
/.english-oss-state.md

# ngữ pháp: cache TTS từng mảnh, mốc thời gian audio (sinh lại bằng npm run grammar:build), checkpoint sản xuất
/scripts/.grammar-tts-cache/
/scripts/.grammar-audio/
/.english-grammar-state.json

# nguồn tải về để kể lại (scripts/fetch-source.mjs)
/scripts/.content-src/
