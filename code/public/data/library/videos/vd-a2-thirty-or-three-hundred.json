{"id":"vd-a2-thirty-or-three-hundred","level":"a2","n":31,"title":{"en":"Sorry, You're Breaking Up","vi":"Xin lỗi, tiếng bị ngắt quãng"},"summary":"Cuộc điện thoại định mệnh: ông Martin đặt bánh cưới, còn Nora vừa nghe chập chờn vừa đoán — người xem nghe rõ hết, chỉ Nora là không.","source":{"type":"story","id":"st-a2-thirty-or-three-hundred","level":"a2","title":{"en":"Thirty or Three Hundred?","vi":"Ba mươi hay ba trăm?"}},"scene":{"background":"kitchen","props":[{"id":"phone","x":820},{"id":"cake","x":1250,"y":560,"scale":0.9}]},"cast":{"nora":{"name":{"en":"Nora","vi":"Nora"},"look":"woman","x":560,"style":{"hair":"bun","hairColor":"#8A5A3B","outfit":"apron","top":"#F3E6D0","topShade":"#E0CFB3"}},"martin":{"name":{"en":"Martin","vi":"Martin"},"look":"man","x":1180,"style":{"hair":"short","hairColor":"#6B6B6B","outfit":"shirt","top":"#7A9A4B","topShade":"#65823C"},"call":{"bg":"village"}}},"lines":[{"speaker":"martin","en":"Hello? Is that Bell's Bakery?","vi":"A lô? Có phải tiệm bánh Bell không?","ipa":["həˈloʊ","ɪz","ðæt","bɛlz","ˈbeɪkɚi"],"start":0.554,"end":3.304,"expression":"neutral","timing":[[0,0.554],[1,1.934],[2,2.192],[3,2.436],[4,2.762]]},{"speaker":"nora","en":"Yes, it is. How can I help you?","vi":"Vâng, đúng rồi. Tôi giúp gì được ạ?","ipa":["jɛs","ɪt","ɪz","haʊ","kæn","aɪ","hɛlp","ju"],"start":4.094,"end":7.264,"expression":"happy","prop":"phone","timing":[[0,4.094],[1,4.691],[2,4.8],[3,6.231],[4,6.462],[5,6.639],[6,6.72],[7,6.965]]},{"speaker":"martin","en":"Can I speak to Nora Bell, please?","vi":"Cho tôi nói chuyện với chị Nora Bell được không?","ipa":["kæn","aɪ","spik","tu","ˈnɔɹə","bɛl","pliz"],"start":8.054,"end":10.054,"expression":"neutral","timing":[[0,8.054],[1,8.169],[2,8.25],[3,8.576],[4,8.712],[5,9.065],[6,9.568]]},{"speaker":"nora","en":"Speaking. Who's calling, please?","vi":"Tôi đây ạ. Xin hỏi ai đang gọi vậy?","ipa":["ˈspikɪŋ","huz","ˈkɔlɪŋ","pliz"],"start":10.844,"end":14.054,"expression":"happy","timing":[[0,10.844],[1,12.461],[2,12.76],[3,13.466]]},{"speaker":"martin","en":"It's Martin Hughes, from Hill Farm. My daughter's getting married!","vi":"Tôi là Martin Hughes, ở trang trại Hill. Con gái tôi sắp cưới!","ipa":["ɪts","ˈmɑɹtən","hjuz","fɹʌm","hɪl","fɑɹm","maɪ","ˈdɔtɚz","ˈɡɛtɪŋ","ˈmɛɹid"],"start":14.844,"end":19.594,"expression":"happy","timing":[[0,14.844],[1,15.02],[2,15.414],[3,16.066],[4,16.297],[5,16.528],[6,18.014],[7,18.245],[8,18.788],[9,19.128]]},{"speaker":"nora","en":"Oh, congratulations! When is the wedding?","vi":"Ôi, chúc mừng anh! Khi nào đám cưới ạ?","ipa":["oʊ","kənˌɡɹætʃəˈleɪʃənz","wɛn","ɪz","ðə","ˈwɛdɪŋ"],"start":20.384,"end":24.154,"expression":"surprised","timing":[[0,20.384],[1,20.873],[2,23.146],[3,23.391],[4,23.526],[5,23.649]]},{"speaker":"martin","en":"On Saturday. It's small and very romantic.","vi":"Thứ Bảy này. Nhỏ thôi, và rất lãng mạn.","ipa":["ɑn","ˈsætɚdi","ɪts","smɔl","ənd","ˈvɛɹi","ɹoʊˈmæntɪk"],"start":24.944,"end":28.784,"expression":"happy","timing":[[0,24.944],[1,25.167],[2,26.884],[3,27.182],[4,27.631],[5,27.767],[6,28.12]]},{"speaker":"nora","en":"Sorry, you're breaking up. Could you say that again?","vi":"Xin lỗi, tiếng bị ngắt quãng. Anh nói lại giúp tôi được không?","ipa":["ˈsɑɹi","jʊɹ","ˈbɹeɪkɪŋ","ʌp","kʊd","ju","seɪ","ðæt","əˈɡɛn"],"start":29.574,"end":33.264,"expression":"confused","timing":[[0,29.574],[1,30.198],[2,30.348],[3,30.796],[4,32.064],[5,32.268],[6,32.39],[7,32.621],[8,32.825]]},{"speaker":"martin","en":"Saturday! The cake is for thirty people.","vi":"Thứ Bảy! Bánh cho ba mươi người.","ipa":["ˈsætɚdi","ðə","keɪk","ɪz","fɔɹ","ˈθɝˌdi","ˈpipəl"],"start":34.054,"end":37.504,"expression":"neutral","timing":[[0,34.054],[1,35.814],[2,36.004],[3,36.344],[4,36.507],[5,36.697],[6,37.037]]},{"speaker":"nora","en":"For… how many people? I can't hear you very well.","vi":"Cho… bao nhiêu người ạ? Tôi nghe không rõ lắm.","ipa":["fɔɹ","haʊ","ˈmɛni","ˈpipəl","aɪ","kænt","hiɹ","ju","ˈvɛɹi","wɛl"],"start":38.294,"end":42.334,"expression":"confused","timing":[[0,38.294],[1,38.869],[2,39.005],[3,39.277],[4,40.803],[5,40.966],[6,41.265],[7,41.496],[8,41.632],[9,41.931]]},{"speaker":"martin","en":"And we can pay about three hundred dollars.","vi":"Và chúng tôi có thể trả khoảng ba trăm đô la.","ipa":["ənd","wi","kæn","peɪ","əˈbaʊt","θɹi","ˈhʌndɹəd","ˈdɑlɚz"],"start":43.124,"end":45.364,"expression":"neutral","timing":[[0,43.124],[1,43.249],[2,43.412],[3,43.603],[4,43.834],[5,44.173],[6,44.459],[7,44.812]]},{"speaker":"nora","en":"Three hundred? Wow! That's a very big cake!","vi":"Ba trăm ạ? Chà! Chiếc bánh to đấy!","ipa":["θɹi","ˈhʌndɹəd","waʊ","ðæts","ə","ˈvɛɹi","bɪɡ","keɪk"],"start":46.154,"end":50.624,"expression":"surprised","timing":[[0,46.154],[1,46.33],[2,47.775],[3,49.201],[4,49.514],[5,49.582],[6,49.908],[7,50.152]]},{"speaker":"martin","en":"Sorry? What did you say?","vi":"Sao cơ? Chị nói gì vậy?","ipa":["ˈsɑɹi","wʌt","dɪd","ju","seɪ"],"start":51.414,"end":53.974,"expression":"confused","timing":[[0,51.414],[1,52.875],[2,53.147],[3,53.364],[4,53.5]]},{"speaker":"nora","en":"I said, no problem! I'll start today!","vi":"Tôi nói là không vấn đề gì ạ! Hôm nay tôi bắt đầu làm luôn!","ipa":["aɪ","sɛd","noʊ","ˈpɹɑbləm","aɪl","stɑɹt","təˈdeɪ"],"start":54.764,"end":58.094,"expression":"happy","timing":[[0,54.764],[1,54.835],[2,55.378],[3,55.582],[4,57.163],[5,57.339],[6,57.652]]},{"speaker":"martin","en":"Hello? Hello? Are you still there?","vi":"A lô? A lô? Chị còn đó không?","ipa":["həˈloʊ","həˈloʊ","ɑɹ","ju","stɪl","ðɛɹ"],"start":58.884,"end":62.834,"expression":"worried","timing":[[0,58.884],[1,60.264],[2,61.745],[3,61.976],[4,62.125],[5,62.438]]},{"speaker":"nora","en":"The line's terrible. I'll call you back!","vi":"Đường dây tệ quá. Tôi sẽ gọi lại cho anh!","ipa":["ðə","laɪnz","ˈtɛɹəbəl","aɪl","kɔl","ju","bæk"],"start":63.624,"end":66.694,"expression":"worried","timing":[[0,63.624],[1,63.691],[2,64.085],[3,65.693],[4,65.897],[5,66.141],[6,66.277]]}],"words":[{"id":"speak","en":"speak","ipa":"spik","vi":"nói; nói chuyện; phát biểu","level":0},{"id":"married","en":"married","ipa":"ˈmɛɹid","vi":"đã kết hôn; đã cưới; có gia đình","level":1},{"id":"wedding","en":"wedding","ipa":"ˈwɛdɪŋ","vi":"đám cưới; lễ cưới","level":1},{"id":"romantic","en":"romantic","ipa":"ɹoʊˈmæntɪk","vi":"lãng mạn; người lãng mạn","level":1},{"id":"hear","en":"hear","ipa":"hiɹ","vi":"nghe; nghe thấy; nghe nói","level":0},{"id":"again","en":"again","ipa":"əˈɡɛn","vi":"lại; lần nữa","level":0}],"focus":{"title":"Nói chuyện điện thoại","pattern":"Can I speak to …? · Speaking. · Who's calling? · Sorry, you're breaking up. · Could you say that again? · I'll call you back.","explain":"Khi nhận máy: \"Speaking.\" = tôi đây (chính là người được hỏi). Hỏi ai gọi: \"Who's calling, please?\". Khi sóng kém: \"You're breaking up\" (tiếng bị ngắt), \"Could you say that again?\" (nói lại giúp tôi). Hẹn gọi lại: \"I'll call you back.\"","keys":["can i speak to","speaking","who's calling","you're breaking up","say that again","call you back"],"lines":[2,3,7,15]},"audio":{"src":"/audio/library/videos/vd-a2-thirty-or-three-hundred.mp3","v":"2e46c0b27e","duration":67.8,"fps":25,"mouth":""}}