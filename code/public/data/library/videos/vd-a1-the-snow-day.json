:[[0,37.664],[1,39.154],[2,39.637],[3,39.779],[4,40.461],[5,40.674],[6,40.774]]},{"speaker":"hana","en":"OK! And our snowman can help, too.","vi":"Vâng ạ! Người tuyết của chúng cháu cũng giúp nữa.","ipa":["oʊˈkeɪ","ənd","ˈaʊɚ","ˈsnoʊˌmæn","kæn","hɛlp","tu"],"start":41.984,"end":46.104,"expression":"happy","gesture":"point","react":{"grant":"happy"},"prop":"snowman","timing":[[0,41.984],[1,43.484],[2,43.768],[3,43.967],[4,44.791],[5,45.018],[6,45.7]]}],"words":[{"id":"help","en":"help","ipa":"hɛlp","vi":"giúp; giúp đỡ; sự trợ giúp","level":0},{"id":"need","en":"need","ipa":"nid","vi":"cần; nhu cầu","level":0},{"id":"shop","en":"shop","ipa":"ʃɑp","vi":"cửa hàng; đi mua sắm","level":0},{"id":"milk","en":"milk","ipa":"mɪlk","vi":"sữa; vắt sữa","level":0},{"id":"snow","en":"snow","ipa":"snoʊ","vi":"tuyết; có tuyết rơi","level":0}],"focus":{"title":"Đề nghị giúp đỡ","pattern":"Can we help you? · Do you need anything? · We can… · Thank you. Yes, please!","explain":"Đề nghị giúp: \"Can I/we help you?\" hoặc hỏi \"Do you need anything?\". Nhận lời thì đáp \"Yes, please!\" kèm cảm ơn; từ chối lịch sự: \"No, thank you. I'm OK.\"","keys":["can we help","do you need","we can","yes, please"],"lines":[3,4,7,9]},"audio":{"src":"/audio/library/videos/vd-a1-the-snow-day.mp3","v":"17d5297d24","duration":47.208,"fps":25,"mouth":""}}