{"id":"vd-a2-the-band-without-a-singer","level":"a2","n":14,"title":{"en":"You'd Be Great!","vi":"Cậu sẽ hát hay lắm!"},"summary":"Ca sĩ chính bị ốm, Zara và Kai tìm mọi cách thuyết phục cậu tay trống Leo đứng lên hát trong lễ hội.","source":{"type":"story","id":"st-a2-the-band-without-a-singer","level":"a2","title":{"en":"The Band Without a Singer","vi":"Ban nhạc không có ca sĩ"}},"scene":{"background":"stage","props":[{"id":"microphone","x":800,"y":760}]},"cast":{"zara":{"name":{"en":"Zara","vi":"Zara"},"look":"teengirl","x":430,"style":{"hair":"curly","hairColor":"#2A1D1A","skin":"#8D5A3B","skinShade":"#74472D","outfit":"jacket","top":"#E5484D","topShade":"#C73A3F"}},"leo":{"name":{"en":"Leo","vi":"Leo"},"look":"teenboy","x":1030,"style":{"hair":"fringe","hairColor":"#C98A3C","outfit":"tee","top":"#3A3F4A","topShade":"#2A2F38"}},"kai":{"name":{"en":"Kai","vi":"Kai"},"look":"teenboy","x":1290,"style":{"hair":"short","hairColor":"#1F1C22","top":"#5DBB63","topShade":"#4AA350"}}},"lines":[{"speaker":"zara","en":"Marcus can't sing on Saturday. His voice is gone.","vi":"Marcus không hát được hôm thứ Bảy. Cậu ấy mất giọng rồi.","ipa":["ˈmɑɹkəs","kænt","sɪŋ","ɑn","ˈsætɚdi","hɪz","vɔɪs","ɪz","ɡɔn"],"start":0.554,"end":4.184,"expression":"sad","timing":[[0,0.554],[1,0.971],[2,1.297],[3,1.582],[4,1.746],[5,2.928],[6,3.091],[7,3.471],[8,3.661]]},{"speaker":"kai","en":"So we have to cancel.","vi":"Vậy là mình phải huỷ thôi.","ipa":["soʊ","wi","hæv","tu","ˈkænsəl"],"start":4.974,"end":5.804,"expression":"sad","gesture":"shrug","timing":[[0,4.974],[1,5.058],[2,5.167],[3,5.287],[4,5.371]]},{"speaker":"zara","en":"No. Leo, you can sing!","vi":"Không. Leo, cậu hát được mà!","ipa":["noʊ","ˈlioʊ","ju","kæn","sɪŋ"],"start":6.594,"end":8.594,"expression":"happy","gesture":"point","timing":[[0,6.594],[1,7.326],[2,7.612],[3,7.816],[4,8.047]]},{"speaker":"leo","en":"Me? No way. I play the drums.","vi":"Tớ á? Không đời nào. Tớ chơi trống cơ mà.","ipa":["mi","noʊ","weɪ","aɪ","pleɪ","ðə","dɹʌmz"],"start":9.384,"end":12.144,"expression":"surprised","gesture":"shake","timing":[[0,9.384],[1,10.079],[2,10.283],[3,10.99],[4,11.057],[5,11.384],[6,11.506]]},{"speaker":"zara","en":"But you wrote the songs. You know every word.","vi":"Nhưng cậu viết mấy bài hát đó. Cậu thuộc từng chữ.","ipa":["bʌt","ju","ɹoʊt","ðə","sɔŋz","ju","noʊ","ˈɛvɚi","wɝd"],"start":12.934,"end":15.764,"gesture":"explain","timing":[[0,12.934],[1,13.045],[2,13.222],[3,13.48],[4,13.588],[5,14.689],[6,14.798],[7,15.002],[8,15.287]]},{"speaker":"leo","en":"Writing is different. I'd be terrible.","vi":"Viết khác chứ. Tớ mà hát thì dở tệ.","ipa":["ˈɹaɪtɪŋ","ɪz","ˈdɪfɚənt","aɪd","bi","ˈtɛɹəbəl"],"start":16.554,"end":19.134,"expression":"worried","timing":[[0,16.554],[1,16.974],[2,17.191],[3,18.197],[4,18.305],[5,18.441]]},{"speaker":"kai","en":"Why not try? You'd be great!","vi":"Sao không thử? Cậu sẽ hát hay lắm!","ipa":["waɪ","nɑt","tɹaɪ","jud","bi","ɡɹeɪt"],"start":19.924,"end":21.474,"expression":"happy","timing":[[0,19.924],[1,19.974],[2,20.131],[3,20.828],[4,20.96],[5,21.08]]},{"speaker":"leo","en":"There will be a thousand people in the audience!","vi":"Sẽ có cả nghìn người ngồi dưới khán giả đấy!","ipa":["ðɛɹ","wɪl","bi","ə","ˈθaʊzənd","ˈpipəl","ɪn","ðə","ˈɑdiəns"],"start":22.264,"end":24.814,"expression":"worried","timing":[[0,22.264],[1,22.365],[2,22.528],[3,22.732],[4,22.827],[5,23.425],[6,23.873],[7,24.009],[8,24.091]]},{"speaker":"zara","en":"Come on, Leo. Just try one song. Only for us.","vi":"Thôi nào, Leo. Cậu thử một bài thôi. Chỉ cho bọn tớ nghe.","ipa":["kʌm","ɑn","ˈlioʊ","dʒʌst","tɹaɪ","wʌn","sɔŋ","ˈoʊnli","fɔɹ","ʌs"],"start":25.604,"end":29.414,"expression":"happy","gesture":"explain","timing":[[0,25.604],[1,25.776],[2,25.966],[3,26.836],[4,27.053],[5,27.311],[6,27.583],[7,28.52],[8,28.792],[9,29.064]]},{"speaker":"leo","en":"I'm too nervous.","vi":"Tớ hồi hộp quá.","ipa":["aɪm","tu","ˈnɝvəs"],"start":30.204,"end":31.104,"expression":"shy","timing":[[0,30.204],[1,30.284],[2,30.474]]},{"speaker":"kai","en":"Everyone is nervous before a festival.","vi":"Trước lễ hội ai mà chẳng hồi hộp.","ipa":["ˈɛvɹiˌwʌn","ɪz","ˈnɝvəs","bɪˈfɔɹ","ə","ˈfɛstəvəl"],"start":31.894,"end":33.834,"gesture":"nod","timing":[[0,31.894],[1,32.255],[2,32.399],[3,32.904],[4,33.228],[5,33.276]]},{"speaker":"zara","en":"What have you got to lose?","vi":"Cậu có mất gì đâu nào?","ipa":["wʌt","hæv","ju","ɡɑt","tu","luz"],"start":34.624,"end":35.974,"expression":"thinking","timing":[[0,34.624],[1,34.708],[2,34.83],[3,34.966],[4,35.238],[5,35.387]]},{"speaker":"leo","en":"My friends… if I sing badly!","vi":"Mất bạn bè… nếu tớ hát dở!","ipa":["maɪ","fɹɛndz","ɪf","aɪ","sɪŋ","ˈbædli"],"start":36.764,"end":39.304,"expression":"shy","react":{"zara":"happy"},"timing":[[0,36.764],[1,36.871],[2,38.108],[3,38.284],[4,38.393],[5,38.719]]},{"speaker":"kai","en":"Ha! We'll still be your friends. Come on!","vi":"Ha! Bọn tớ vẫn là bạn cậu mà. Nào!","ipa":["hɑ","wil","stɪl","bi","jɔɹ","fɹɛndz","kʌm","ɑn"],"start":40.094,"end":42.434,"expression":"happy","gesture":"cheer","timing":[[0,40.094],[1,40.675],[2,40.771],[3,40.964],[4,41.048],[5,41.18],[6,42.069],[7,42.19]]},{"speaker":"leo","en":"OK. One song. Where's the microphone?","vi":"Thôi được. Một bài thôi đấy. Micro đâu rồi?","ipa":["oʊˈkeɪ","wʌn","sɔŋ","wɛɹz","ðə","ˈmaɪkɹəˌfoʊn"],"start":43.224,"end":46.244,"expression":"thinking","prop":"microphone","timing":[[0,43.224],[1,43.882],[2,44.099],[3,44.996],[4,45.309],[5,45.431]]},{"speaker":"zara","en":"Right here. Let's practice!","vi":"Đây này. Tập thôi!","ipa":["ɹaɪt","hiɹ","lɛts","ˈpɹæktəs"],"start":47.034,"end":49.174,"expression":"happy","gesture":"point","react":{"kai":"happy"},"prop":"microphone","timing":[[0,47.034],[1,47.254],[2,48.123],[3,48.395]]}],"words":[{"id":"voice","en":"voice","ipa":"vɔɪs","vi":"giọng nói; tiếng nói; giọng","level":1},{"id":"audience","en":"audience","ipa":"ˈɑdiəns","vi":"khán giả; người xem","level":1},{"id":"festival","en":"festival","ipa":"ˈfɛstəvəl","vi":"lễ hội; liên hoan","level":0},{"id":"song","en":"song","ipa":"sɔŋ","vi":"bài hát; ca khúc","level":0},{"id":"practice","en":"practice","ipa":"ˈpɹæktəs","vi":"thực hành; luyện tập; thói quen","level":0},{"id":"nervous","en":"nervous","ipa":"ˈnɝvəs","vi":"lo lắng, hồi hộp; thuộc thần kinh","level":1}],"focus":{"title":"Thuyết phục ai đó","pattern":"You'd be great! · Why not? · Come on! · Just try… · What have you got to lose?","explain":"Thuyết phục bằng lời khen và lời mời thử: \"You'd (= you would) be great!\", \"Just try one song.\" Khi người kia ngần ngại, hỏi lại \"Why not?\" hoặc động viên \"Come on!\".","keys":["you'd be","why not","come on","just try","what have you got to lose"],"lines":[6,8,11,13]},"audio":{"src":"/audio/library/videos/vd-a2-the-band-without-a-singer.mp3","v":"266a6d5a47","duration":50.28,"fps":25,"mouth":""}}