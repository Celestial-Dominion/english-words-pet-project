,[1,54.139],[2,54.329],[3,54.478],[4,55.063],[5,55.144],[6,55.266]]},{"speaker":"pedro","en":"We'll call you as soon as we find it.","vi":"Chúng tôi sẽ gọi cho chị ngay khi tìm thấy.","ipa":["wil","kɔl","ju","æz","sun","æz","wi","faɪnd","ɪt"],"start":56.224,"end":57.794,"expression":"happy","timing":[[0,56.224],[1,56.329],[2,56.573],[3,56.736],[4,56.845],[5,57.103],[6,57.212],[7,57.32],[8,57.687]]},{"speaker":"rana","en":"Thank you. Please find it before Saturday!","vi":"Cảm ơn anh. Làm ơn tìm thấy nó trước thứ Bảy nhé!","ipa":["θæŋk","ju","pliz","faɪnd","ɪt","bɪˈfɔɹ","ˈsætɚdi"],"start":58.584,"end":61.404,"expression":"worried","react":{"pedro":"happy"},"timing":[[0,58.584],[1,58.766],[2,59.559],[3,59.939],[4,60.184],[5,60.293],[6,60.687]]}],"words":[{"id":"missing","en":"missing","ipa":"ˈmɪsɪŋ","vi":"mất tích; bị thiếu; bị mất","level":1},{"id":"describe","en":"describe","ipa":"dɪˈskɹaɪb","vi":"mô tả; miêu tả","level":0},{"id":"handle","en":"handle","ipa":"ˈhændəl","vi":"tay cầm; xử lý, giải quyết","level":1},{"id":"wedding","en":"wedding","ipa":"ˈwɛdɪŋ","vi":"đám cưới; lễ cưới","level":1},{"id":"flight","en":"flight","ipa":"flaɪt","vi":"chuyến bay; sự bay","level":1},{"id":"delay","en":"delay","ipa":"dɪˈleɪ","vi":"sự chậm trễ; trì hoãn","level":1}],"focus":{"title":"Báo mất đồ và mô tả đồ vật","pattern":"My … is missing. · I've lost… · It's large and green, with… · When did you…? · We'll call you as soon as…","explain":"Báo sự việc vừa xảy ra còn ảnh hưởng tới bây giờ dùng hiện tại hoàn thành: \"I've lost my suitcase.\" Mô tả đồ vật theo thứ tự: cỡ → màu → chi tiết với \"with\": \"It's large and green, with a black handle.\"","keys":["is missing","i've lost","with a","as soon as","can you describe"],"lines":[1,7,8,9,15]},"audio":{"src":"/audio/library/videos/vd-a2-the-lost-suitcase.mp3","v":"1c89c415b8","duration":62.496,"fps":25,"mouth":""}}