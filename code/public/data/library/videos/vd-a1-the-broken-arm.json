{"id":"vd-a1-the-broken-arm","level":"a1","n":29,"title":{"en":"My Arm Hurts","vi":"Cháu đau tay"},"summary":"Ở phòng khám, bác sĩ Adams hỏi Mei chuyện gì đã xảy ra và đau ở chỗ nào; mẹ ngồi bên cạnh.","source":{"type":"story","id":"st-a1-the-broken-arm","level":"a1","title":{"en":"The Broken Arm","vi":"Cánh tay bị gãy"}},"scene":{"background":"hospital","props":[{"id":"thermometer","x":820}]},"cast":{"mei":{"name":{"en":"Mei","vi":"Mei"},"look":"girl","x":560,"style":{"hair":"bob","hairColor":"#1F1C22","top":"#F2C14E","topShade":"#D9A933","collar":"#FFFFFF"}},"mom":{"name":{"en":"Mom","vi":"Mẹ"},"look":"mom","x":330,"style":{"hairColor":"#1F1C22","top":"#8C7BC2","topShade":"#7666AD"}},"adams":{"name":{"en":"Dr. Adams","vi":"Bác sĩ Adams"},"look":"woman","x":1180,"style":{"outfit":"coat","skin":"#8D5A3B","skinShade":"#74472D","hair":"bun","hairColor":"#2A1D1A","glasses":true}}},"lines":[{"speaker":"adams","en":"Hello, Mei. I'm Dr. Adams. What's wrong?","vi":"Chào Mei. Bác là bác sĩ Adams. Cháu bị làm sao?","ipa":["həˈloʊ","meɪ","aɪm","dɹaɪv","ˈædəmz","wʌts","ɹɔŋ"],"start":0.554,"end":5.914,"expression":"happy","timing":[[0,0.554],[1,1.313],[2,2.755],[3,2.996],[4,3.479],[5,5.113],[6,5.425]]},{"speaker":"mei","en":"My arm hurts.","vi":"Cháu đau tay ạ.","ipa":["maɪ","ɑɹm","hɝts"],"start":6.704,"end":8.014,"expression":"tearful","timing":[[0,6.704],[1,6.918],[2,7.301]]},{"speaker":"adams","en":"I see. What happened?","vi":"Bác hiểu rồi. Chuyện gì đã xảy ra thế?","ipa":["aɪ","si","wʌt","ˈhæpənd"],"start":8.804,"end":11.234,"expression":"thinking","timing":[[0,8.804],[1,8.924],[2,10.493],[3,10.72]]},{"speaker":"mei","en":"I fell from a tree in the park.","vi":"Cháu ngã từ trên cây trong công viên ạ.","ipa":["aɪ","fɛl","fɹʌm","ə","tɹi","ɪn","ðə","pɑɹk"],"start":12.024,"end":13.984,"expression":"sad","timing":[[0,12.024],[1,12.168],[2,12.552],[3,12.807],[4,12.893],[5,13.361],[6,13.518],[7,13.645]]},{"speaker":"mom","en":"She was very high in the tree.","vi":"Cháu nó trèo lê