":72.246,"timing":[[0,69.306],[1,69.544],[2,69.906],[3,70.044],[4,71.343],[5,71.593],[6,71.756]]},{"k":"n","sec":"real","parts":[{"v":"Một câu mời rất lịch sự. Nhưng cẩn thận: nói trống không "},{"e":"Whatever!"},{"v":" khi ai đó hỏi ý kiến thì nghe như “sao cũng được, kệ”, rất dễ làm người khác phật lòng."}],"b":8,"start":72.886,"end":82.986,"cues":[[0,77.276]]},{"k":"n","sec":"mistakes","parts":[{"e":"Ever"},{"v":" dính liền vào từ hỏi: "},{"e":"wherever"},{"v":"."}],"b":9,"start":83.976,"end":86.946},{"k":"e","sec":"mistakes","en":"You can sit wherever you like.","vi":"Bạn ngồi đâu cũng được.","ipa":["ju","kæn","sɪt","wɛˈɹɛvɚ","ju","laɪk"],"bad":{"en":"You can sit where you like ever."},"b":9,"start":87.486,"end":88.926,"timing":[[0,87.486],[1,87.583],[2,87.759],[3,88.021],[4,88.421],[5,88.546]]},{"k":"n","sec":"mistakes","parts":[{"e":"However"},{"v":" đứng ngay trước tính từ, trạng từ: "},{"e":"however hard"},{"v":"."}],"b":10,"start":89.566,"end":93.546},{"k":"e","sec":"mistakes","en":"However hard I try, I can't sleep.","vi":"Dù cố thế nào, tôi vẫn không ngủ được.","ipa":["ˌhaʊˈɛvɚ","hɑɹd","aɪ","tɹaɪ","aɪ","kænt","slip"],"bad":{"en":"However I try hard, I can't sleep."},"b":10,"start":94.086,"end":96.346,"timing":[[0,94.086],[1,94.464],[2,94.726],[3,94.826],[4,95.438],[5,95.589],[6,95.901]]},{"k":"n","sec":"mistakes","parts":[{"v":"Mệnh đề này nói về tương lai nhưng dùng hiện tại đơn."}],"b":11,"start":96.986,"end":99.806},{"k":"e","sec":"mistakes","en":"Whatever happens, I'll help you.","vi":"Dù chuyện gì xảy ra, tôi cũng sẽ giúp bạn.","ipa":["ˌwʌˈtɛvɚ","ˈhæpənz","aɪl","hɛlp","ju"],"bad":{"en":"Whatever will happen, I'll help you."},"b":11,"start":100.346,"end":102.146,"timing":[[0,100.346],[1,100.756],[2,101.443],[3,101.581],[4,101.818]]},{"k":"e","sec":"dialogue","en":"Mom, whenever I eat slowly, you finish first!","vi":"Mẹ ơi, lần nào con ăn chậm là mẹ lại ăn xong trước!","ipa":["mɑm","wɛˈnɛvɚ","aɪ","it","ˈsloʊli","ju","ˈfɪnɪʃ","fɝst"],"who":"max","ann":{