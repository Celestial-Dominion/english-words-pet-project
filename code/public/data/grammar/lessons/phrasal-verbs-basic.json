V, please.","vi":"Bật tivi lên đi.","ipa":["tɝn","ɑn","ðə","ˈtiˈvi","pliz"],"b":18,"start":137.274,"end":139.014,"timing":[[0,137.274],[1,137.513],[2,137.68],[3,137.777],[4,138.43]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh: Tôi đang tìm điện thoại."}],"b":19,"hold":1,"start":139.654,"end":142.044},{"k":"e","sec":"recall","en":"I'm looking for my phone.","vi":"Tôi đang tìm điện thoại.","ipa":["aɪm","ˈlʊkɪŋ","fɔɹ","maɪ","foʊn"],"b":20,"start":142.584,"end":144.024,"timing":[[0,142.584],[1,142.726],[2,143.115],[3,143.295],[4,143.49]]},{"k":"n","sec":"recap","parts":[{"v":"Cụm động từ: học cả cụm, như một từ mới. Gặp đại từ thì đặt nó vào giữa: "},{"e":"turn it on"},{"v":", "},{"e":"pick it up"},{"v":". Và phân biệt "},{"e":"put on"},{"v":", hành động mặc vào, với "},{"e":"wear"},{"v":", đang mặc."}],"b":21,"start":145.014,"end":157.884}],"boards":[{"type":"title"},{"type":"scene"},{"type":"table","head":["Cụm động từ","Nghĩa"],"rows":[["get up · wake up","thức dậy · tỉnh giấc"],["turn on · turn off","bật · tắt"],["put on · take off","mặc vào · cởi ra"],["look for","tìm"],["pick up","nhặt lên · đón"],["give back · come back","trả lại · quay lại"]]},{"type":"move","from":["Turn","on","the","TV","."],"to":["Turn","the","TV","on","."]},{"type":"formula","rows":[[{"x":"turn"},{"x":"it / them","en":1},{"x":"on · pick"},{"x":"it / them","en":1},{"x":"up"}]]},{"type":"line","beat":9},{"type":"line","beat":10},{"type":"pair","beats":[11,12],"labels":["put on: hành động mặc vào","wear: đang có trên người"]},{"type":"line","beat":14},{"type":"line","beat":15},{"type":"line","beat":16},{"type":"line","beat":17},{"type":"line","beat":18},{"type":"fix","beat":20},{"type":"fix","beat":22},{"type":"fix","beat":24},{"type":"scene"},{"type":"quiz","q":"Nói bằng tiếng Anh: Bật tivi lên đi.","beat":30},{"type":"line","beat":30},{"type":"quiz","q":"Nói bằng tiếng Anh: Tôi đang tìm điện thoại.","beat":32},{"type":"line","beat":32},{"type":"recap"}],"ex":[{"k":"fill","stem":"I can't find my glasses. I'm looking ___ them.","o":["for","at","up"],"a":0,"why":"Tìm → look for."},{"k":"fill","stem":"It's cold. ___ your jacket.","o":["Put on","Wear on","Take off"],"a":0,"why":"Hành động mặc vào → put on."},{"k":"fix","stem":"The TV is too loud. Turn off it.","o":["The TV is too loud. Turn it off.","The TV is too loud. Turn off.","The TV is too loud. Turn it of."],"a":0,"why":"Đại từ đứng giữa: turn it off."},{"k":"contrast","stem":"She's ___ a beautiful red dress today.","o":["wearing","putting on"],"a":0,"why":"Đang mặc trên người → wearing."},{"k":"type","stem":"What time do you usually get ___? (thức dậy)","ans":["up"],"why":"Get up = thức dậy."},{"k":"choice","q":"“Can you pick me up at six?” nghĩa là:","o":["Sáu giờ bạn đón tôi được không?","Sáu giờ bạn nhặt đồ giúp tôi được không?","Sáu giờ bạn gọi tôi dậy được không?"],"a":0,"why":"Pick someone up = đón ai."},{"k":"order","parts":["I'll","give","it","back","tomorrow"],"end":".","vi":"Mai tôi trả lại nhé."},{"k":"listen","beat":14,"o":["Please sit down.","Please stand up.","Please sit here."],"a":0,"en":1,"why":"Nghe sit down."},{"k":"natural","o":["I'm looking for my keys.","I'm looking my keys."],"a":0}],"words":[{"id":"get","ipa":"ɡɛt","vi":"lấy; nhận được; trở nên","level":0},{"id":"turn","ipa":"tɝn","vi":"quay; rẽ; lượt","level":0},{"id":"pick","ipa":"pɪk","vi":"chọn; nhặt; hái","level":0},{"id":"wear","ipa":"wɛɹ","vi":"mặc, đeo; mòn; đồ mặc","level":0},{"id":"alarm","ipa":"əˈlɑɹm","vi":"báo động; chuông báo thức; sự hoảng sợ","level":1},{"id":"uniform","ipa":"ˈjunəˌfɔɹm","vi":"đồng phục; đồng nhất","level":1},{"id":"jacket","ipa":"ˈdʒækət","vi":"áo khoác","level":0}],"audio":{"src":"/audio/grammar/phrasal-verbs-basic.mp3","v":"84338c905e","duration":158.784,"fps":25,"mouth":""}}