":"dialogue","en":"I'd rather dry. And next time, I'd rather we just ordered pizza!","vi":"Tôi lau khô. Mà lần sau, tôi mong mình gọi pizza cho xong!","ipa":["aɪd","ˈɹæðɚ","dɹaɪ","ənd","nɛkst","taɪm","aɪd","ˈɹæðɚ","wi","dʒʌst","ˈɔɹdɚd","ˈpitsə"],"who":"nam","ann":{"expression":"happy"},"b":14,"start":125.946,"end":130.216,"timing":[[0,125.946],[1,126.014],[2,126.313],[3,127.176],[4,127.301],[5,127.589],[6,128.539],[7,128.664],[8,128.939],[9,129.051],[10,129.351],[11,129.701]]},{"k":"e","sec":"dialogue","en":"If only it were that easy!","vi":"Giá mà dễ vậy!","ipa":["ɪf","ˈoʊnli","ɪt","wɝ","ðæt","ˈizi"],"who":"ben","ann":{"expression":"happy"},"b":14,"start":131.006,"end":132.486,"timing":[[0,131.006],[1,131.179],[2,131.491],[3,131.604],[4,131.766],[5,132.004]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh, dùng "},{"e":"It's time"},{"v":": Đến lúc bạn đi ngủ rồi đấy."}],"b":15,"hold":1,"start":133.476,"end":137.756},{"k":"e","sec":"recall","en":"It's time you went to bed.","vi":"Đến lúc bạn đi ngủ rồi đấy.","ipa":["ɪts","taɪm","ju","wɛnt","tu","bɛd"],"b":16,"start":138.296,"end":139.576,"timing":[[0,138.296],[1,138.459],[2,138.746],[3,138.884],[4,139.096],[5,139.209]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh, dùng "},{"e":"If only"},{"v":": Giá mà hôm qua tôi nghe lời bạn."}],"b":17,"hold":1,"start":140.216,"end":144.666},{"k":"e","sec":"recall","en":"If only I had listened to you yesterday.","vi":"Giá mà hôm qua tôi nghe lời bạn.","ipa":["ɪf","ˈoʊnli","aɪ","hæd","ˈlɪsənd","tu","ju","ˈjɛstɚˌdeɪ"],"b":18,"start":145.206,"end":147.246,"timing":[[0,145.206],[1,145.306],[2,145.681],[3,145.794],[4,145.981],[5,146.306],[6,146.393],[7,146.531]]},{"k":"n","sec":"recap","parts":[{"v":"Sau "},{"e":"If only"},{"v":", "},{"e":"would rather"},{"v":" cộng người khác, "},{"e":"It's time"},{"v":" và "},{"e":"as if"},{"v":" với điều không thật, động từ lùi về quá khứ. Chuyện đã qua thì lùi thêm: "},{"e":"had"},{"v":" cộng V3. Lùi thì ở đây là để báo điều không thật, hoặc chưa xảy ra."}],"b":19,"start":148.236,"end":164.216}],"boards":[{"type":"title"},{"type":"scene"},{"type":"formula","rows":[[{"x":"If only / would rather / It's time","en":1},{"x":"chủ ngữ"},{"x":"động từ quá khứ"}]]},{"type":"table","head":["Mẫu","Nghĩa","Ví dụ"],"rows":[["If only + quá khứ","giá mà (bây giờ)","If only I had a car."],["If only + had V3","giá mà (lúc đó)","If only I'd listened."],["would rather + S + quá khứ","mong người khác…","I'd rather you stayed."],["It's time + S + quá khứ","đến lúc phải… rồi","It's time we left."],["as if + quá khứ","cứ như thể","He acts as if he were the boss."]]},{"type":"line","beat":7},{"type":"line","beat":8},{"type":"line","beat":9},{"type":"line","beat":10},{"type":"pair","beats":[11,12],"labels":["cùng một người: + nguyên thể","người khác: + chủ ngữ + quá khứ"]},{"type":"pair","beats":[14,15],"labels":["có thể thật: giữ thì bình thường","không thật: lùi về quá khứ"]},{"type":"rank","items":[{"en":"He acts as if he were the boss.","vi":"Anh ta cư xử như thể mình là sếp.","g":"best","beat":17},{"en":"He acts as if he was the boss.","vi":"Anh ta làm như mình là sếp vậy.","g":"ok","beat":18}]},{"type":"fix","beat":21},{"type":"fix","beat":23},{"type":"fix","beat":25},{"type":"scene"},{"type":"quiz","q":"Nói bằng tiếng Anh, dùng It's time: Đến lúc bạn đi ngủ rồi đấy.","beat":31},{"type":"line","beat":31},{"type":"quiz","q":"Nói bằng tiếng Anh, dùng If only: Giá mà hôm qua tôi nghe lời bạn.","beat":33},{"type":"line","beat":33},{"type":"recap"}],"ex":[{"k":"fill","stem":"It's high time you ___ your room.","o":["cleaned","clean","will clean"],"a":0,"why":"It's time + S + quá khứ."},{"k":"fill","stem":"I'd rather you ___ smoke in here.","o":["didn't","don't","won't"],"a":0,"why":"would rather + S + quá khứ."},{"k":"fill","stem":"If only I ___ the truth earlier!","o":["had known","knew","have known"],"a":0,"why":"Tiếc về quá khứ → had + V3."},{"k":"fill","stem":"He looks at me as if I ___ crazy.","o":["were