:"type","stem":"Despite the fact ___ it was late, we kept working.","ans":["that"],"why":"Despite the fact that."},{"k":"order","parts":["We","lost","the","game","despite","playing","well"],"end":".","vi":"Chúng tôi thua dù đã chơi tốt."},{"k":"listen","beat":7,"o":["Despite his age, he runs every morning.","Because of his age, he walks every morning.","Despite the rain, he runs every morning."],"a":0,"en":1,"why":"Nghe despite his age."},{"k":"natural","o":["Despite the rain, we went out.","Despite it was raining, we went out."],"a":0}],"words":[{"id":"despite","ipa":"dɪˈspaɪt","vi":"mặc dù; bất chấp","level":2},{"id":"whereas","ipa":"wɛˈɹæz","vi":"trong khi đó; ngược lại thì","level":3},{"id":"prefer","ipa":"pɹəˈfɝ","vi":"thích hơn; ưa chuộng hơn","level":1},{"id":"sunshine","ipa":"ˈsʌnˌʃaɪn","vi":"ánh nắng; ánh nắng mặt trời","level":0},{"id":"injury","ipa":"ˈɪndʒɚi","vi":"chấn thương; vết thương; tổn hại","level":2},{"id":"countryside","ipa":"ˈkʌntɹiˌsaɪd","vi":"vùng nông thôn; miền quê","level":1}],"audio":{"src":"/audio/grammar/despite-whereas.mp3","v":"d1e75d8ce8","duration":161.904,"fps":25,"mouth":""}}