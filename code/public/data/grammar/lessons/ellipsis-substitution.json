.","vi":"Dân số Tokyo đông hơn dân số London."},{"k":"listen","beat":0,"o":["I don't like this phone. Can I see the red one?","I don't like this phone. Can I see the black one?","I don't like these phones. Can I see the red ones?"],"a":0,"en":1,"why":"Nghe the red one."},{"k":"natural","o":["I think so.","I think yes."],"a":0}],"words":[{"id":"popular","ipa":"ˈpɑpjəlɚ","vi":"phổ biến; được ưa chuộng; nổi tiếng","level":1},{"id":"battery","ipa":"ˈbætɚi","vi":"pin; ắc quy","level":1},{"id":"monthly","ipa":"ˈmʌnθli","vi":"hàng tháng; nguyệt san","level":2},{"id":"population","ipa":"ˌpɑpjəˈleɪʃən","vi":"dân số; dân cư; quần thể","level":1},{"id":"climate","ipa":"ˈklaɪmət","vi":"khí hậu; bầu không khí chung","level":2},{"id":"resign","ipa":"ɹɪˈzaɪn","vi":"từ chức; xin nghỉ việc; cam chịu","level":3}],"audio":{"src":"/audio/grammar/ellipsis-substitution.mp3","v":"0a4ee16297","duration":165.048,"fps":25,"mouth":""}}