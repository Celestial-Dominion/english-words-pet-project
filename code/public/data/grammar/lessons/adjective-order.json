,97.589],[3,97.954],[4,98.084]]},{"k":"e","sec":"dialogue","en":"But it's such a lovely old box...","vi":"Nhưng cái hộp cũ ấy đẹp lắm mà...","ipa":["bʌt","ɪts","sʌtʃ","ə","ˈlʌvli","oʊld","bɑks"],"who":"zoe","ann":{"expression":"shy"},"b":12,"start":99.204,"end":101.104,"timing":[[0,99.204],[1,99.272],[2,99.442],[3,99.728],[4,99.806],[5,100.275],[6,100.522]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh: Tôi có một con mèo đen nhỏ."}],"b":13,"hold":1,"start":102.094,"end":104.914},{"k":"e","sec":"recall","en":"I have a small black cat.","vi":"Tôi có một con mèo đen nhỏ.","ipa":["aɪ","hæv","ə","smɔl","blæk","kæt"],"b":14,"start":105.454,"end":106.934,"timing":[[0,105.454],[1,105.551],[2,105.722],[3,105.814],[4,106.182],[5,106.498]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh: Cô ấy mua một chiếc bàn gỗ cũ rất đẹp."}],"b":15,"hold":1,"start":107.574,"end":110.914},{"k":"e","sec":"recall","en":"She bought a beautiful old wooden table.","vi":"Cô ấy mua một chiếc bàn gỗ cũ rất đẹp.","ipa":["ʃi","bɑt","ə","ˈbjutəfəl","oʊld","ˈwʊdən","ˈteɪbəl"],"b":16,"start":111.454,"end":113.534,"timing":[[0,111.454],[1,111.62],[2,111.883],[3,111.962],[4,112.501],[5,112.751],[6,113.041]]},{"k":"n","sec":"recap","parts":[{"v":"Tính từ đứng trước danh từ, theo thứ tự: ý kiến, kích cỡ, tuổi, màu, nguồn gốc, chất liệu. Chất liệu đứng sát danh từ nhất. Và thường chỉ cần hai, ba tính từ là đủ."}],"b":17,"start":114.524,"end":126.974}],"boards":[{"type":"title"},{"type":"scene"},{"type":"table","head":["Thứ tự","Ví dụ"],"rows":[["1. ý kiến","lovely, beautiful, nice"],["2. kích cỡ","big, small, long"],["3. tuổi","old, new, young"],["4. màu","red, brown, white"],["5. nguồn gốc","Vietnamese, Italian"],["6. chất liệu","wooden, leather, silk"]]},{"type":"line","beat":6},{"type":"line","beat":7},{"type":"line","beat":8},{"type":"line","beat":9},{"type":"rank","items":[{"en":"It's a beautiful old house.","vi":"Đó là một ngôi nhà cũ rất đẹp.","g":"best","beat":10},{"en":"It's