},{"v":", "},{"e":"wonder"},{"v":", dùng "},{"e":"if"},{"v":" hay "},{"e":"whether"},{"v":" đều được. Nhưng làm chủ ngữ, hay đứng sau giới từ như "},{"e":"on"},{"v":", "},{"e":"about"},{"v":", thì chỉ có "},{"e":"whether"},{"v":"."}],"b":8,"start":54.976,"end":67.666,"cues":[[0,56.396],[0,58.996],[1,59.906],[0,64.876],[1,67.176]]},{"k":"e","sec":"natural","en":"It's obvious that he lied.","vi":"Rõ ràng là anh ta nói dối.","ipa":["ɪts","ˈɑbviəs","ðæt","hi","laɪd"],"b":9,"start":68.556,"end":69.896,"timing":[[0,68.556],[1,68.669],[2,69.218],[3,69.343],[4,69.456]]},{"k":"e","sec":"natural","en":"That he lied is obvious.","vi":"Việc anh ta nói dối là điều hiển nhiên.","ipa":["ðæt","hi","laɪd","ɪz","ˈɑbviəs"],"b":9,"start":70.536,"end":71.926,"timing":[[0,70.536],[1,70.671],[2,70.809],[3,71.158],[4,71.283]]},{"k":"n","sec":"natural","parts":[{"v":"Mệnh đề "},{"e":"that"},{"v":" làm chủ ngữ nghe rất trang trọng. Thường người ta đưa nó ra sau, với "},{"e":"It"},{"v":" ở đầu câu, hoặc dùng "},{"e":"The fact that"},{"v":"."}],"b":9,"start":72.566,"end":82.116,"cues":[[0,78.976]]},{"k":"n","sec":"mistakes","parts":[{"v":"Làm chủ ngữ thì dùng "},{"e":"whether"},{"v":", không dùng "},{"e":"if"},{"v":"."}],"b":10,"start":83.106,"end":86.256},{"k":"e","sec":"mistakes","en":"Whether we win depends on the weather.","vi":"Chúng tôi có thắng hay không còn tùy thời tiết.","ipa":["ˈwɛðɚ","wi","wɪn","dɪˈpɛndz","ɑn","ðə","ˈwɛðɚ"],"bad":{"en":"If we win depends on the weather."},"b":10,"start":86.796,"end":88.516,"timing":[[0,86.796],[1,87.056],[2,87.194],[3,87.468],[4,87.893],[5,88.006],[6,88.093]]},{"k":"n","sec":"mistakes","parts":[{"v":"Mệnh đề danh từ dùng trật tự câu kể: "},{"e":"what she said"},{"v":"."}],"b":11,"start":89.156,"end":92.506},{"k":"e","sec":"mistakes","en":"What she said surprised everyone.","vi":"Điều cô ấy nói khiến mọi người bất ngờ.","ipa":["wʌt","ʃi","sɛd","sɚˈpɹaɪzd","ˈɛvɹiˌwʌn"],"bad":{"en":"What did she say surprised everyone."},"b":11,"start":93.046,"end":94