,{"e":"twice"},{"v":", "},{"e":"three times"},{"v":" trước "},{"e":"as … as"},{"v":". Muốn nói kém xa, dùng "},{"e":"nowhere near as"},{"v":" hoặc "},{"e":"not nearly as"},{"v":"."}],"b":2,"start":35.256,"end":45.256},{"k":"e","sec":"examples","en":"My new apartment is twice as big as my old one.","vi":"Căn hộ mới của tôi rộng gấp đôi căn cũ.","ipa":["maɪ","nu","əˈpɑɹtmənt","ɪz","twaɪs","æz","bɪɡ","æz","maɪ","oʊld","wʌn"],"hl":[[20,35,"k"]],"b":3,"start":46.146,"end":48.716,"timing":[[0,46.146],[1,46.234],[2,46.484],[3,46.996],[4,47.146],[5,47.508],[6,47.646],[7,47.871],[8,47.971],[9,48.146],[10,48.371]]},{"k":"e","sec":"examples","en":"The sequel was nowhere near as good as the first movie.","vi":"Phần hai kém xa phần một.","ipa":["ðə","ˈsikwəl","wɑz","ˈnoʊˌwɛɹ","nɪɹ","æz","ɡʊd","æz","ðə","fɝst","ˈmuvi"],"hl":[[15,38,"n"]],"b":4,"start":49.356,"end":52.046,"timing":[[0,49.356],[1,49.454],[2,49.854],[3,50.016],[4,50.404],[5,50.654],[6,50.779],[7,51.054],[8,51.154],[9,51.266],[10,51.591]]},{"k":"e","sec":"examples","en":"He's nearly as tall as his father now.","vi":"Giờ cậu ấy cao gần bằng bố rồi.","ipa":["hiz","ˈnɪɹli","æz","tɔl","æz","hɪz","ˈfɑðɚ","naʊ"],"hl":[[5,22,"k"]],"b":5,"start":52.686,"end":54.606,"timing":[[0,52.686],[1,52.804],[2,53.191],[3,53.316],[4,53.604],[5,53.716],[6,53.879],[7,54.229]]},{"k":"e","sec":"examples","en":"She's by far the best player on the team.","vi":"Cô ấy là người chơi giỏi nhất đội, hơn hẳn mọi người.","ipa":["ʃiz","baɪ","fɑɹ","ðə","bɛst","ˈpleɪɚ","ɑn","ðə","tim"],"hl":[[6,21,"k"]],"b":6,"start":55.246,"end":57.406,"timing":[[0,55.246],[1,55.461],[2,55.636],[3,55.949],[4,56.061],[5,56.361],[6,56.736],[7,56.849],[8,56.936]]},{"k":"e","sec":"examples","en":"Rent in the city center is three times higher than here.","vi":"Tiền thuê nhà ở trung tâm đắt gấp ba ở đây.","ipa":["ɹɛnt","ɪn","ðə","ˈsɪti","ˈsɛntɚ","ɪz","θɹi","taɪmz","ˈhaɪɚ","ðæn","hiɹ"],"hl":[[27,50,"k"]],"b":7,"start":58.046,"end":60.756,"timing":[[0,58.046],[1,58.296],[2,58.371],[3,58.471],[4,58.746],[5,59.133],[6,59.296],[7,59.533],[8,59.933],[9,60.271],[10,60.383]]},{"k":"e","sec":"natural","en":"It's twice as big as my old room.","vi":"Nó rộng gấp đôi phòng cũ của tôi.","ipa":["ɪts","twaɪs","æz","bɪɡ","æz","maɪ","oʊld","ɹum"],"b":8,"start":61.746,"end":63.626,"timing":[[0,61.746],[1,61.908],[2,62.258],[3,62.396],[4,62.633],[5,62.746],[6,62.934],[7,63.184]]},{"k":"e","sec":"natural","en":"It's two times bigger than my old room.","vi":"Nó to hơn phòng cũ gấp hai lần.","ipa":["ɪts","tu","taɪmz","ˈbɪɡɚ","ðæn","maɪ","oʊld","ɹum"],"b":8,"start":64.266,"end":66.316,"timing":[[0,64.266],[1,64.428],[2,64.654],[3,65.053],[4,65.366],[5,65.466],[6,65.654],[7,65.878]]},{"k":"n","sec":"natural","parts":[{"v":"Với “gấp đôi”, "},{"e":"twice as … as"},{"v":" là chuẩn và tự nhiên nhất. "},{"e":"Two times bigger"},{"v":" vẫn nghe thấy khi nói chuyện. Còn "},{"e":"twice bigger"},{"v":" thì lạ tai, nên tránh."}],"b":8,"start":66.956,"end":77.956,"cues":[[1,71.246],[2,75.326]]},{"k":"e","sec":"contrast","en":"The subway is much faster than the bus.","vi":"Tàu điện ngầm nhanh hơn xe buýt nhiều.","ipa":["ðə","ˈsʌbˌweɪ","ɪz","mʌtʃ","ˈfæstɚ","ðæn","ðə","bʌs"],"b":9,"start":78.846,"end":80.906,"timing":[[0,78.846],[1,78.943],[2,79.369],[3,79.506],[4,79.794],[5,80.218],[6,80.343],[7,80.431]]},{"k":"e","sec":"contrast","en":"The bus is nowhere near as fast as the subway.","vi":"Xe buýt chậm hơn tàu điện ngầm rất xa.","ipa":["ðə","bʌs","ɪz","ˈnoʊˌwɛɹ","nɪɹ","æz","fæst","æz","ðə","ˈsʌbˌweɪ"],"b":9,"start":81.546,"end":84.046,"timing":[[0,81.546],[1,81.643],[2,81.944],[3,82.081],[4,82.468],[5,82.694],[6,82.843],[7,83.244],[8,83.331],[9,83.444]]},{"k":"n","sec":"contrast","parts":[{"v":"Hai câu cùng một ý, nhưng nhìn từ hai phía. "},{"e":"Nowhere near as fast as"},{"v":" nhấn mạnh khoảng cách rất lớn, mạnh hơn "},{"e":"not as fast as"},{"v":"."}],"b":9,"start":84.686,"end":92.996,"cues":[[1,87.686]]},{"k":"n","sec":"mistakes","parts":[{"v":"Gấp đôi: "},{"e":"twice