 good!","vi":"Món súp này rất ngon!","ipa":["ðɪs","sup","ɪz","ˈvɛɹi","ɡʊd"],"b":8,"start":68.764,"end":70.234,"timing":[[0,68.764],[1,68.999],[2,69.305],[3,69.485],[4,69.832]]},{"k":"n","sec":"natural","parts":[{"v":"Người Việt khen “ngon quá!”, rồi dịch thành "},{"e":"too good"},{"v":". Nhưng "},{"e":"too"},{"v":" luôn mang ý quá mức, như thể có vấn đề. Muốn khen, hãy dùng "},{"e":"so"},{"v":", "},{"e":"really"},{"v":" hoặc "},{"e":"very"},{"v":": "},{"e":"It's so good!"}],"b":8,"start":70.874,"end":84.474,"cues":[[2,73.834],[2,75.134],[1,82.734]]},{"k":"n","sec":"mistakes","parts":[{"e":"Enough"},{"v":" đứng sau tính từ: "},{"e":"old enough"},{"v":"."}],"b":9,"start":85.464,"end":87.984},{"k":"e","sec":"mistakes","en":"He's old enough to drive.","vi":"Anh ấy đủ tuổi lái xe rồi.","ipa":["hiz","oʊld","ɪˈnʌf","tu","dɹaɪv"],"bad":{"en":"He's enough old to drive."},"b":9,"start":88.524,"end":89.924,"timing":[[0,88.524],[1,88.729],[2,88.993],[3,89.298],[4,89.437]]},{"k":"n","sec":"mistakes","parts":[{"v":"Trước tính từ chỉ cần "},{"e":"too"},{"v":", không có "},{"e":"much"},{"v":"."}],"b":10,"start":90.564,"end":93.964},{"k":"e","sec":"mistakes","en":"This coffee is too hot.","vi":"Cà phê này nóng quá.","ipa":["ðɪs","ˈkɑfi","ɪz","tu","hɑt"],"bad":{"en":"This coffee is too much hot."},"b":10,"start":94.504,"end":96.074,"timing":[[0,94.504],[1,94.725],[2,95.183],[3,95.378],[4,95.628]]},{"k":"n","sec":"mistakes","parts":[{"e":"Cars"},{"v":" đếm được, nên dùng "},{"e":"too many"},{"v":"."}],"b":11,"start":96.714,"end":99.714},{"k":"e","sec":"mistakes","en":"There are too many cars.","vi":"Có quá nhiều xe.","ipa":["ðɛɹ","ɑɹ","tu","ˈmɛni","kɑɹz"],"bad":{"en":"There are too much cars."},"b":11,"start":100.254,"end":101.724,"timing":[[0,100.254],[1,100.447],[2,100.586],[3,100.822],[4,101.114]]},{"k":"e","sec":"dialogue","en":"Is the coffee cool enough now?","vi":"Giờ cà phê nguội đủ chưa anh?","ipa":["ɪz","ðə","ˈkɑfi","kul","ɪˈnʌf","naʊ"],"who":"jay","ann":{"expression":"thinki