et"},{"v":": Tôi bị lạc ở Hà Nội."}],"b":16,"hold":1,"start":115.046,"end":118.856},{"k":"e","sec":"recall","en":"I got lost in Hanoi.","vi":"Tôi bị lạc ở Hà Nội.","ipa":["aɪ","ɡɑt","lɔst","ɪn","ˈhænɔɪ"],"b":17,"start":119.396,"end":120.676,"timing":[[0,119.396],[1,119.448],[2,119.686],[3,120.048],[4,120.123]]},{"k":"n","sec":"recap","parts":[{"v":"Việc đang được làm: "},{"e":"is being"},{"v":" cộng phân từ. Nói thân mật, nhất là chuyện bất ngờ: "},{"e":"get"},{"v":" cộng phân từ, như "},{"e":"got stolen"},{"v":", "},{"e":"got hurt"},{"v":". Và với động từ hai tân ngữ, hãy để người nhận làm chủ ngữ: "},{"e":"I was given"},{"v":"."}],"b":18,"start":121.666,"end":136.506}],"boards":[{"type":"title"},{"type":"scene"},{"type":"table","head":["Loại","Cấu trúc","Ví dụ"],"rows":[["bị động tiếp diễn","is / was being + V3","The house is being painted."],["bị động với get","get / got + V3","He got fired."],["hai tân ngữ","người + was given…","She was offered a job."]]},{"type":"line","beat":6},{"type":"line","beat":7},{"type":"line","beat":8},{"type":"line","beat":9},{"type":"line","beat":10},{"type":"pair","beats":[11,12],"labels":["be: có thể chỉ trạng thái, đã vỡ sẵn","get: nhấn vào chuyện xảy ra"]},{"type":"rank","items":[{"en":"I was given a free coffee.","vi":"Tôi được mời một cốc cà phê miễn phí.","g":"best","beat":14},{"en":"A free coffee was given to me.","vi":"Một cốc cà phê miễn phí được đưa cho tôi.","g":"ok","beat":15}]},{"type":"fix","beat":18},{"type":"fix","beat":20},{"type":"fix","beat":22},{"type":"scene"},{"type":"quiz","q":"Nói bằng tiếng Anh: Căn phòng đang được dọn.","beat":28},{"type":"line","beat":28},{"type":"quiz","q":"Nói bằng tiếng Anh, dùng get: Tôi bị lạc ở Hà Nội.","beat":30},{"type":"line","beat":30},{"type":"recap"}],"ex":[{"k":"fill","stem":"The bridge ___ built right now.","o":["is being","is","was being"],"a":0,"why":"Đang được xây → is being built."},{"k":"fill","stem":"When I got there, my car ___ washed.","o":["was being","is being","was"],"a":0,"why":"Đang được rửa lúc đó → was being."},{"k":"fill","stem":"My wallet ___ stolen on the bus yesterday.","o":["got","get","getting"],"a":0,"why":"Chuyện không may, thân mật → got stolen."},{"k":"fix","stem":"The house is painting this week.","o":["The house is being painted this week.","The house is being paint this week.","The house painting this week."],"a":0,"why":"Bị động tiếp diễn."},{"k":"transform","q":"Chuyển sang bị động, người nhận làm chủ ngữ:","stem":"They gave me a gift.","o":["I was given a gift.","A gift gave me.","I was gave a gift."],"a":0,"why":"Người nhận làm chủ ngữ."},{"k":"choice","q":"“Did you get hurt?” nghĩa là:","o":["Bạn có bị thương không?","Bạn có làm ai đau không?","Bạn có thấy đau không?"],"a":0,"why":"Get + V3 = bị."},{"k":"type","stem":"They got ___ last spring. (cưới)","ans":["married"],"why":"Get married."},{"k":"order","parts":["A","new","hospital","is","being","built","in","our","town"],"end":".","vi":"Một bệnh viện mới đang được xây ở thị trấn chúng tôi."},{"k":"listen","beat":7,"o":["I felt like I was being watched.","I felt like I was watching.","I feel like I'm being watched."],"a":0,"en":1,"why":"Nghe was being watched."},{"k":"natural","o":["My car is being repaired now.","My car is repairing now."],"a":0}],"words":[{"id":"repair","ipa":"ɹɪˈpɛɹ","vi":"sửa chữa; việc sửa chữa","level":1},{"id":"hurt","ipa":"hɝt","vi":"làm đau; bị thương; đau","level":0},{"id":"luckily","ipa":"ˈlʌkəli","vi":"may thay; may mắn là","level":1},{"id":"offer","ipa":"ˈɔfɚ","vi":"đề nghị; lời mời; cung cấp","level":1},{"id":"marry","ipa":"ˈmɛɹi","vi":"cưới, kết hôn","level":1},{"id":"fire","ipa":"ˈfaɪɚ","vi":"lửa; hỏa hoạn; sa thải","level":0}],"audio":{"src":"/audio/grammar/passive-continuous-get.mp3","v":"bde97e7eb9","duration":137.376,"fps":25,"mouth":""}}