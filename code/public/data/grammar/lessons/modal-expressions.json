:"may well / might as well","en":1},{"x":"nguyên thể"}]]},{"type":"table","head":["Cách nói","Nghĩa","Ví dụ"],"rows":[["be bound to · be sure to","chắc chắn sẽ","It's bound to rain."],["be likely to · be unlikely to","nhiều, ít khả năng","He's unlikely to come."],["may well · could well","rất có thể","You may well be right."],["might as well · may as well","… luôn cho xong","We might as well walk."]]},{"type":"line","beat":8},{"type":"line","beat":9},{"type":"line","beat":10},{"type":"line","beat":11},{"type":"pair","beats":[12,13],"labels":["may well: rất có thể","might as well: đành vậy, không có cách hay hơn"]},{"type":"rank","items":[{"en":"He'll probably be late.","vi":"Chắc anh ấy sẽ đến muộn.","g":"best","beat":15},{"en":"He'll likely be late.","vi":"Nhiều khả năng anh ấy sẽ đến muộn.","g":"ok","beat":16}]},{"type":"fix","beat":19},{"type":"fix","beat":21},{"type":"fix","beat":23},{"type":"scene"},{"type":"quiz","q":"Nói bằng tiếng Anh, dùng bound to: Kiểu gì cô ấy cũng thích món quà này.","beat":29},{"type":"line","beat":29},{"type":"quiz","q":"Nói bằng tiếng Anh, dùng might as well: Cửa hàng đóng cửa rồi. Thôi mình về nhà luôn cho rồi.","beat":31},{"type":"line","beat":31},{"type":"recap"}],"ex":[{"k":"fill","stem":"Take an umbrella. It's ___ rain later.","o":["bound to","bound","bound for"],"a":0,"why":"be bound to + nguyên thể."},{"k":"fill","stem":"He's very busy, so he's ___ to come.","o":["unlikely","unlike","impossible"],"a":0,"why":"Ít khả năng → unlikely to."},{"k":"fill","stem":"The last train has gone. We might as well ___ a taxi.","o":["take","to take","taking"],"a":0,"why":"might as well + nguyên thể, không to."},{"k":"fix","stem":"You may well to be right.","o":["You may well be right.","You may be well right.","You may well are right."],"a":0,"why":"may well + nguyên thể."},{"k":"transform","q":"Viết lại với likely:","stem":"It is probable that prices will rise.","o":["Prices are likely to rise.","Prices are likely rise.","Prices are probable to rise."],"a":0,"why":"Chủ ngữ + be likely to + V."},{"k":"choice","q":"“We might as well walk.” nghĩa là:","o":["Chẳng có cách nào hay hơn, thì đi bộ luôn","Chúng ta đi bộ rất giỏi","Chúng ta bắt buộc phải đi bộ"],"a":0,"why":"might as well = đành vậy, làm luôn cho xong."},{"k":"choice","q":"Câu nào nghĩa là “rất có thể”?","o":["It may well snow tonight.","It might as well snow tonight.","It may as well snow tonight."],"a":0,"why":"may well = rất có thể."},{"k":"type","stem":"You've worked so hard. You're ___ to pass. (chắc chắn)","ans":["bound","sure","certain"],"why":"be bound / sure / certain to = chắc chắn sẽ."},{"k":"order","parts":["Prices","are","likely","to","rise","again","next","year"],"end":".","vi":"Giá cả nhiều khả năng sẽ lại tăng vào năm sau."},{"k":"listen","beat":1,"o":["In this rain, it's bound to be late.","In this rain, it's likely to be late.","In this rain, it's bound to be full."],"a":0,"en":1,"why":"Nghe bound to be late."},{"k":"natural","o":["He is likely come late.","He is likely to come late."],"a":1}],"words":[{"id":"bound","ipa":"baʊnd","vi":"chắc chắn sẽ; bị ràng buộc; trên đường đến; nhảy vọt","level":2},{"id":"likely","ipa":"ˈlaɪkli","vi":"có khả năng; dễ xảy ra; có lẽ","level":1},{"id":"unlikely","ipa":"ənˈlaɪkli","vi":"khó xảy ra; ít có khả năng","level":2},{"id":"empty","ipa":"ˈɛmpti","vi":"rỗng, trống; làm rỗng","level":1},{"id":"typical","ipa":"ˈtɪpəkəl","vi":"điển hình; tiêu biểu; đặc trưng","level":2},{"id":"probable","ipa":"ˈpɹɑbəbəl","vi":"có khả năng xảy ra; có lẽ đúng","level":3}],"audio":{"src":"/audio/grammar/modal-expressions.mp3","v":"bf7bb43563","duration":172.032,"fps":25,"mouth":""}}