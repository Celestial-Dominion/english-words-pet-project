,43.341],[7,43.526]]},{"k":"e","sec":"examples","en":"She asked what time the shop opened.","vi":"Cô ấy hỏi mấy giờ cửa hàng mở cửa.","ipa":["ʃi","æskt","wʌt","taɪm","ðə","ʃɑp","ˈoʊpənd"],"hl":[[4,9,"k"],[10,19,"q"],[29,35,"k"]],"b":4,"start":44.704,"end":46.664,"timing":[[0,44.704],[1,44.893],[2,45.235],[3,45.406],[4,45.735],[5,45.827],[6,46.209]]},{"k":"e","sec":"examples","en":"He asked me whether I liked spicy food.","vi":"Anh ấy hỏi tôi có thích đồ cay không.","ipa":["hi","æskt","mi","ˈwɛðɚ","aɪ","laɪkt","ˈspaɪsi","fud"],"hl":[[3,8,"k"],[12,19,"c"],[22,27,"k"]],"b":5,"start":47.304,"end":49.574,"timing":[[0,47.304],[1,47.41],[2,47.739],[3,47.897],[4,48.252],[5,48.331],[6,48.66],[7,49.147]]},{"k":"e","sec":"contrast","en":"Please wait here.","vi":"Vui lòng chờ ở đây.","ipa":["pliz","weɪt","hiɹ"],"b":6,"start":50.564,"end":51.444,"timing":[[0,50.564],[1,50.845],[2,51.069]]},{"k":"e","sec":"contrast","en":"She asked me to wait there.","vi":"Cô ấy nhờ tôi chờ ở đó.","ipa":["ʃi","æskt","mi","tu","weɪt","ðɛɹ"],"b":6,"start":52.084,"end":53.474,"timing":[[0,52.084],[1,52.286],[2,52.615],[3,52.733],[4,52.839],[5,53.115]]},{"k":"n","sec":"contrast","parts":[{"v":"Lời nhờ, lời khuyên, mệnh lệnh thì kể lại bằng "},{"e":"asked"},{"v":" hoặc "},{"e":"told"},{"v":", cộng người, cộng "},{"e":"to"},{"v":" và động từ. Phủ định thì đặt "},{"e":"not"},{"v":" trước "},{"e":"to"},{"v":": "},{"e":"He told me not to worry"},{"v":"."}],"b":6,"start":54.114,"end":66.904,"cues":[[1,57.564],[1,60.554],[1,64.974]]},{"k":"e","sec":"contrast","en":"He told me not to worry.","vi":"Anh ấy bảo tôi đừng lo.","ipa":["hi","toʊld","mi","nɑt","tu","ˈwɝi"],"hl":[[3,7,"k"],[11,17,"n"]],"b":7,"start":67.444,"end":68.724,"timing":[[0,67.444],[1,67.508],[2,67.784],[3,67.916],[4,68.179],[5,68.284]]},{"k":"e","sec":"contrast","en":"The doctor told her to rest for a week.","vi":"Bác sĩ dặn cô ấy nghỉ ngơi một tuần.","ipa":["ðə","ˈdɑktɚ","toʊld","hɝ","tu","ɹɛst","fɔɹ","ə","wik"],"hl":[[11,15,"k"],[20,22,"k"