{"id":"prepositions-time","lv":"a1","n":19,"cat":"prepositions","t":"At, on, in với thời gian","en":"at 7:00 · on Monday · in July","sum":"At cho giờ và thời điểm (at 7:00, at noon, at night), on cho ngày (on Monday, on May 5th, on my birthday), in cho khoảng dài (in July, in 2020, in the morning, in summer). Không dùng giới từ trước next, last, every, this, tomorrow.","forms":[{"f":"at + giờ / thời điểm","vi":"at 7:00, at noon, at night"},{"f":"on + ngày","vi":"on Monday, on May 5th, on my birthday"},{"f":"in + tháng / năm / mùa / buổi","vi":"in July, in 2020, in the morning"},{"f":"không giới từ: next / last / every / this / tomorrow","vi":"every day, next week"}],"pts":[{"id":"prepositions-time","name":"Prepositions of time: at / on / in","vi":"At 7:00, on Monday, in July; không giới từ trước next / last / every"}],"cast":{"mom":{"name":{"en":"Mom","vi":"Mẹ"},"look":"mom","x":1040},"zoe":{"name":{"en":"Zoe","vi":"Zoe"},"look":"teengirl","style":{"top":"#E0607E","topShade":"#C44B68","accent":"#C44B68","hair":"ponytail","hairColor":"#8B5A2B"},"x":560}},"bg":"home-evening","props":[{"id":"cake","x":820}],"beats":[{"k":"e","sec":"hook","en":"Mom, when is my party?","vi":"Mẹ ơi, bữa tiệc của con là khi nào ạ?","ipa":["mɑm","wɛn","ɪz","maɪ","ˈpɑɹti"],"who":"zoe","ann":{"expression":"happy"},"b":1,"start":0.454,"end":1.944,"timing":[[0,0.454],[1,0.764],[2,0.992],[3,1.162],[4,1.347]]},{"k":"e","sec":"hook","en":"It's on Saturday, at six o'clock.","vi":"Vào thứ bảy, lúc sáu giờ.","ipa":["ɪts","ɑn","ˈsætɚdi","æt","sɪks","əˈklɑk"],"who":"mom","ann":{"expression":"happy","bubble":"calendar:SAT"},"b":1,"start":2.734,"end":5.044,"timing":[[0,2.734],[1,2.868],[2,3.067],[3,3.933],[4,4.132],[5,4.473]]},{"k":"e","sec":"hook","en":"In the evening?","vi":"Buổi tối ạ?","ipa":["ɪn","ðə","ˈivnɪŋ"],"who":"zoe","ann":{"expression":"thinking"},"b":1,"start":5.834,"end":6.774,"timing":[[0,5.834],[1,5.95],[2,6.021]]},{"k":"e","sec":"hook","en":"Yes, in the evening.","vi":"Ừ, buổi tối.","ipa":["jɛs","ɪn","ðə","ˈivnɪŋ"],"who":"mom","ann":{"gesture":"nod","prop":"cake"},"b":1,"start":7.564,"end":9.124,"timing":[[0,7.564],[1,8.266],[2,8.423],[3,8.494]]},{"k":"n","sec":"hook","parts":[{"v":"Ba câu, ba giới từ khác nhau: "},{"e":"on Saturday"},{"v":", "},{"e":"at six o'clock"},{"v":", "},{"e":"in the evening"},{"v":". Tiếng Việt thường chỉ dùng “vào” hoặc “lúc”, tiếng Anh thì phải chọn đúng từ."}],"b":1,"start":9.764,"end":19.834},{"k":"n","sec":"form","parts":[{"v":"Mẹo nhớ: "},{"e":"at"},{"v":" là một điểm nhỏ, như giờ. "},{"e":"On"},{"v":" là một ngày. "},{"e":"In"},{"v":" là khoảng dài hơn: tháng, năm, mùa, hay một buổi trong ngày."}],"b":2,"start":20.824,"end":31.494,"cues":[[0,21.754],[1,24.694],[2,26.674]]},{"k":"e","sec":"form","en":"The class starts at nine.","vi":"Lớp học bắt đầu lúc chín giờ.","ipa":["ðə","klæs","stɑɹts","æt","naɪn"],"hl":[[17,19,"k"]],"b":3,"start":32.034,"end":33.614,"timing":[[0,32.034],[1,32.119],[2,32.56],[3,32.972],[4,33.09]]},{"k":"e","sec":"form","en":"I was born in 2005.","vi":"Tôi sinh năm 2005.","ipa":["aɪ","wɑz","bɔɹn","ɪn",""],"hl":[[11,13,"k"]],"b":4,"start":34.254,"end":36.194,"timing":[[0,34.254],[1,34.329],[2,34.55],[3,34.903],[4,35.333]]},{"k":"e","sec":"form","en":"We go to the beach in summer.","vi":"Chúng tôi đi biển vào mùa hè.","ipa":["wi","ɡoʊ","tu","ðə","bitʃ","ɪn","ˈsʌmɚ"],"hl":[[19,21,"k"]],"b":5,"start":36.834,"end":38.464,"timing":[[0,36.834],[1,36.963],[2,37.169],[3,37.272],[4,37.419],[5,37.787],[6,37.949]]},{"k":"e","sec":"form","en":"The shop is closed on Sundays.","vi":"Cửa hàng đóng cửa vào chủ nhật.","ipa":["ðə","ʃɑp","ɪz","kloʊzd","ɑn","ˈsʌnˌdeɪz"],"hl":[[19,21,"k"]],"b":6,"start":39.104,"end":41.314,"timing":[[0,39.104],[1,39.219],[2,39.645],[3,39.807],[4,40.336],[5,40.572]]},{"k":"e","sec":"contrast","en":"I study in the morning.","vi":"Tôi học vào buổi sáng.","ipa":["aɪ","ˈstʌdi","ɪn","ðə","ˈmɔɹnɪŋ"],"b":7,"start":42.304,"end":43.644,"timing":[[0,42.304],[1,42.399],[2,42.884],[3,42.987],[4,4