{"id":"possessive-adjectives","lv":"a1","n":7,"cat":"pronouns","t":"My, your, his, her…: tính từ sở hữu","en":"my · your · his · her · its · our · their","sum":"My, your, his, her, its, our, their = của tôi, của bạn, của anh ấy… Chúng đứng TRƯỚC danh từ (my phone), không đổi theo số nhiều (my friends). His = của anh ấy, her = của cô ấy; its (của nó) khác it's (it is).","forms":[{"f":"my · your · his · her · its · our · their + danh từ","vi":"của tôi, của bạn, của anh ấy, của cô ấy, của nó, của chúng tôi, của họ"},{"f":"its = của nó · it's = it is","vi":"không viết nhầm"}],"pts":[{"id":"possessive-adjectives","name":"Possessive adjectives","vi":"Tính từ sở hữu: my, your, his, her, its, our, their"},{"id":"its-vs-it-s","name":"its vs it's","vi":"its (của nó) khác it's (it is)"}],"cast":{"linh":{"name":{"en":"Linh","vi":"Linh"},"look":"woman","style":{"outfit":"blouse","top":"#9A6FC4","topShade":"#8159AA","accent":"#8159AA","hair":"bob","hairColor":"#1C1716","skin":"#F2CFAE","skinShade":"#E0B592"},"x":560},"mia":{"name":{"en":"Mia","vi":"Mia"},"look":"woman","style":{"outfit":"blouse","top":"#D9774F","topShade":"#BF6340","accent":"#C8603B","hair":"long","hairColor":"#6B4226"},"x":1040}},"bg":"home-day","beats":[{"k":"e","sec":"hook","en":"This is a photo of my family.","vi":"Đây là ảnh gia đình mình.","ipa":["ðɪs","ɪz","ə","ˈfoʊˌtoʊ","ʌv","maɪ","ˈfæməli"],"who":"linh","ann":{"expression":"happy","bubble":"photo:mom,dad,girl"},"b":1,"start":0.454,"end":2.134,"timing":[[0,0.454],[1,0.629],[2,0.757],[3,0.842],[4,1.24],[5,1.339],[6,1.51]]},{"k":"e","sec":"hook","en":"Who's this girl?","vi":"Cô bé này là ai thế?","ipa":["huz","ðɪs","ɡɝl"],"who":"mia","ann":{"expression":"thinking"},"b":1,"start":2.924,"end":3.834,"timing":[[0,2.924],[1,3.077],[2,3.318]]},{"k":"e","sec":"hook","en":"That's my sister. Her name is Hoa.","vi":"Đó là em gái mình. Tên em ấy là Hoa.","ipa":["ðæts","maɪ","ˈsɪstɚ","hɝ","neɪm","ɪz","hoʊ"],"who":"linh","ann":{"expression":"happy"},"b":1,"start":4.624,