ontrast","en":"The keys are in the box.","vi":"Chìa khóa ở trong hộp.","ipa":["ðə","kiz","ɑɹ","ɪn","ðə","bɑks"],"b":9,"start":51.134,"end":52.674,"timing":[[0,51.134],[1,51.259],[2,51.685],[3,51.818],[4,51.965],[5,52.068]]},{"k":"e","sec":"contrast","en":"The keys are on the box.","vi":"Chìa khóa ở trên hộp.","ipa":["ðə","kiz","ɑɹ","ɑn","ðə","bɑks"],"b":9,"start":53.314,"end":54.934,"timing":[[0,53.314],[1,53.439],[2,53.85],[3,54.027],[4,54.218],[5,54.321]]},{"k":"n","sec":"contrast","parts":[{"v":"Người Việt hay nói “trên” cho cả hai trường hợp. Hãy tự hỏi: vật ở BÊN TRONG hay nằm TRÊN MẶT? Bên trong thì dùng "},{"e":"in"},{"v":", trên mặt thì dùng "},{"e":"on"},{"v":"."}],"b":9,"start":55.574,"end":66.384,"cues":[[0,64.044],[1,65.834]]},{"k":"n","sec":"mistakes","parts":[{"v":"Sách nằm bên trong túi thì dùng "},{"e":"in"},{"v":". "},{"e":"On the bag"},{"v":" là nằm trên mặt túi."}],"b":10,"start":67.374,"end":72.134},{"k":"e","sec":"mistakes","en":"The book is in the bag.","vi":"Quyển sách ở trong túi.","ipa":["ðə","bʊk","ɪz","ɪn","ðə","bæɡ"],"bad":{"en":"The book is on the bag."},"b":10,"start":72.674,"end":73.924,"timing":[[0,72.674],[1,72.813],[2,73.108],[3,73.24],[4,73.358],[5,73.46]]},{"k":"n","sec":"mistakes","parts":[{"e":"Next to"},{"v":" là cụm hai từ, không được bỏ "},{"e":"to"},{"v":"."}],"b":11,"start":74.564,"end":78.354},{"k":"e","sec":"mistakes","en":"The shop is next to the bank.","vi":"Cửa hàng ở cạnh ngân hàng.","ipa":["ðə","ʃɑp","ɪz","nɛkst","tu","ðə","bæŋk"],"bad":{"en":"The shop is next the bank."},"b":11,"start":78.894,"end":80.734,"timing":[[0,78.894],[1,79.023],[2,79.479],[3,79.641],[4,80.038],[5,80.126],[6,80.273]]},{"k":"n","sec":"mistakes","parts":[{"e":"In front of"},{"v":" có ba từ, nhớ đủ "},{"e":"of"},{"v":"."}],"b":12,"start":81.374,"end":84.514},{"k":"e","sec":"mistakes","en":"The park is in front of the school.","vi":"Công viên ở trước trường.","ipa":["ðə","pɑɹk","ɪz","ɪn","fɹʌnt","ʌv","ðə","skul"],"bad":{"en":"The park is in front the school."},"b":12,"start":85.054,"end":86.904,"timing":[[0,85.054],[1,85.284],[2,85.59],[3,85.723],[4,85.87],[5,86.149],[6,86.252],[7,86.37]]},{"k":"e","sec":"dialogue","en":"Dad, where are my shoes?","vi":"Bố ơi, giày của con đâu ạ?","ipa":["dæd","wɛɹ","ɑɹ","maɪ","ʃuz"],"who":"lily","ann":{"expression":"thinking"},"b":13,"start":88.044,"end":89.974,"timing":[[0,88.044],[1,88.756],[2,89.026],[3,89.168],[4,89.381]]},{"k":"e","sec":"dialogue","en":"Are they under your bed?","vi":"Có phải ở dưới giường con không?","ipa":["ɑɹ","ðeɪ","ˈʌndɚ","jɔɹ","bɛd"],"who":"dad","ann":{"expression":"thinking"},"b":13,"start":90.764,"end":92.054,"timing":[[0,90.764],[1,90.874],[2,91.115],[3,91.414],[4,91.627]]},{"k":"e","sec":"dialogue","en":"No, they aren't.","vi":"Không có bố ạ.","ipa":["noʊ","ðeɪ","ˈɑɹənt"],"who":"lily","ann":{"gesture":"shake"},"b":13,"start":92.844,"end":94.194,"timing":[[0,92.844],[1,93.438],[2,93.666]]},{"k":"e","sec":"dialogue","en":"Look! They're next to the door.","vi":"Nhìn kìa! Chúng ở cạnh cửa đấy.","ipa":["lʊk","ðɛɹ","nɛkst","tu","ðə","dɔɹ"],"who":"dad","ann":{"gesture":"point"},"b":13,"start":94.984,"end":97.954,"timing":[[0,94.984],[1,96.464],[2,96.777],[3,97.16],[4,97.317],[5,97.487]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh: Con chó ở dưới cái bàn."}],"b":14,"hold":1,"start":98.944,"end":101.594},{"k":"e","sec":"recall","en":"The dog is under the table.","vi":"Con chó ở dưới cái bàn.","ipa":["ðə","dɔɡ","ɪz","ˈʌndɚ","ðə","ˈteɪbəl"],"b":15,"start":102.134,"end":103.794,"timing":[[0,102.134],[1,102.273],[2,102.656],[3,102.818],[4,103.097],[5,103.229]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh: Quán cà phê ở cạnh ngân hàng."}],"b":16,"hold":1,"start":104.434,"end":107.314},{"k":"e","sec":"recall","en":"The cafe is next to the bank.","vi":"Quán cà phê ở cạnh ngân hàng.","ipa":["ðə","kəˈfeɪ","ɪz","nɛkst","tu","ðə","bæŋk"],"b":17,"start":107.854,"end":109.774,"timing":[[0,107.854],[1,107.954],[2,108.528],[3,108.689],[