{"id":"and-but-because","lv":"a1","n":26,"cat":"clauses","t":"Nối câu: and, but, or, so, because","en":"and · but · or · so · because","sum":"Nối hai ý: and (và — thêm ý), but (nhưng — trái ý), or (hoặc — lựa chọn), so (nên — kết quả), because (vì — lý do). So và because đi theo cặp ngược chiều: It's raining, so I'm staying home = I'm staying home because it's raining.","forms":[{"f":"ý 1 + and + ý 2","vi":"thêm"},{"f":"ý 1 + but + ý 2","vi":"trái ngược"},{"f":"… or …","vi":"lựa chọn"},{"f":"nguyên nhân + so + kết quả","vi":"vì thế"},{"f":"kết quả + because + nguyên nhân","vi":"bởi vì"}],"pts":[{"id":"conjunctions-basic","name":"and / but / or / so / because","vi":"Nối câu cơ bản"}],"cast":{"zoe":{"name":{"en":"Zoe","vi":"Zoe"},"look":"teengirl","style":{"top":"#E0607E","topShade":"#C44B68","accent":"#C44B68","hair":"ponytail","hairColor":"#8B5A2B"},"x":1040},"sam":{"name":{"en":"Sam","vi":"Sam"},"look":"teenboy","style":{"top":"#F0A43A","topShade":"#D68C27","accent":"#C77E1C","hairColor":"#5A3A22","skin":"#C98E68","skinShade":"#B27852"},"x":560}},"bg":"train","beats":[{"k":"e","sec":"hook","en":"Do you want to go out tonight?","vi":"Tối nay cậu muốn đi chơi không?","ipa":["du","ju","wɑnt","tu","ɡoʊ","aʊt","təˈnaɪt"],"who":"sam","ann":{"expression":"happy"},"b":1,"start":0.454,"end":1.664,"timing":[[0,0.454],[1,0.483],[2,0.565],[3,0.755],[4,0.823],[5,1.027],[6,1.244]]},{"k":"e","sec":"hook","en":"I want to, but I'm tired.","vi":"Muốn chứ, nhưng tớ mệt.","ipa":["aɪ","wɑnt","tu","bʌt","aɪm","ˈtaɪɚd"],"who":"zoe","ann":{"expression":"tired"},"b":1,"start":2.454,"end":3.914,"timing":[[0,2.454],[1,2.499],[2,2.754],[3,2.925],[4,3.124],[5,3.308]]},{"k":"e","sec":"hook","en":"Because you get up early?","vi":"Vì cậu dậy sớm à?","ipa":["bɪˈkɔz","ju","ɡɛt","ʌp","ˈɝli"],"who":"sam","ann":{"expression":"thinking"},"b":1,"start":4.704,"end":6.054,"timing":[[0,4.704],[1,4.961],[2,5.097],[3,5.301],[4,5.532]]},{"k":"e","sec":"hook","en":"Yes. And I have a test tomorrow, so I need to