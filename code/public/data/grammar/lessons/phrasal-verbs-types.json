ỏng rồi!","ipa":["ˈɡɹændmɑ","ðə","ˈwɑʃɪŋ","məˈʃin","bɹoʊk","daʊn","əˈɡɛn"],"who":"max","ann":{"expression":"worried"},"b":13,"start":105.246,"end":108.196,"timing":[[0,105.246],[1,106.029],[2,106.154],[3,106.616],[4,107.116],[5,107.466],[6,107.766]]},{"k":"e","sec":"dialogue","en":"Oh dear. I'll call someone to fix it. Can you turn it off?","vi":"Ôi trời. Bà sẽ gọi người đến sửa. Cháu tắt nó đi được không?","ipa":["oʊ","dɪɹ","aɪl","kɔl","ˈsʌmˌwʌn","tu","fɪks","ɪt","kæn","ju","tɝn","ɪt","ɔf"],"who":"grandma","ann":{"expression":"worried"},"b":13,"start":108.986,"end":114.216,"timing":[[0,108.986],[1,109.163],[2,110.669],[3,110.933],[4,111.21],[5,111.572],[6,111.683],[7,112.03],[8,113.238],[9,113.419],[10,113.53],[11,113.752],[12,113.835]]},{"k":"e","sec":"dialogue","en":"Done! And don't worry, I'll look after everything.","vi":"Xong rồi ạ! Bà đừng lo, cháu sẽ trông nom mọi thứ.","ipa":["dʌn","ənd","doʊnt","ˈwɝi","aɪl","lʊk","ˈæftɚ","ˈɛvɹiˌθɪŋ"],"who":"max","ann":{"expression":"happy"},"b":13,"start":115.006,"end":119.016,"timing":[[0,115.006],[1,116.241],[2,116.441],[3,116.754],[4,117.416],[5,117.666],[6,117.879],[7,118.316]]},{"k":"e","sec":"dialogue","en":"You've grown up so much!","vi":"Cháu lớn nhiều quá rồi!","ipa":["juv","ɡɹoʊn","ʌp","soʊ","mʌtʃ"],"who":"grandma","ann":{"expression":"happy"},"b":13,"start":119.806,"end":121.386,"timing":[[0,119.806],[1,119.997],[2,120.317],[3,120.469],[4,120.803]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh, dùng "},{"e":"pick up"},{"v":": Cái túi rơi rồi. Bạn nhặt nó lên đi."}],"b":14,"hold":1,"start":122.376,"end":128.056},{"k":"e","sec":"recall","en":"The bag fell. Pick it up.","vi":"Cái túi rơi rồi. Bạn nhặt nó lên đi.","ipa":["ðə","bæɡ","fɛl","pɪk","ɪt","ʌp"],"b":15,"start":128.596,"end":131.106,"timing":[[0,128.596],[1,128.694],[2,129.006],[3,130.344],[4,130.619],[5,130.731]]},{"k":"n","sec":"recall","parts":[{"v":"Nói bằng tiếng Anh, dùng "},{"e":"look after"},{"v":": Ai sẽ trông bọn trẻ?"}],"b":16,"hold":