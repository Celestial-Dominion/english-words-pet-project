án phủ định dùng "},{"e":"can't"},{"v":", không dùng "},{"e":"mustn't"},{"v":"."}],"b":10,"start":72.874,"end":76.224},{"k":"e","sec":"mistakes","en":"He can't be at home. His car is gone.","vi":"Chắc chắn anh ấy không ở nhà. Xe anh ấy không còn đó.","ipa":["hi","kænt","bi","æt","hoʊm","hɪz","kɑɹ","ɪz","ɡɔn"],"bad":{"en":"He mustn't be at home. His car is gone."},"b":10,"start":76.764,"end":79.794,"timing":[[0,76.764],[1,76.829],[2,77.141],[3,77.279],[4,77.354],[5,78.641],[6,78.879],[7,79.179],[8,79.329]]},{"k":"n","sec":"mistakes","parts":[{"v":"Sau "},{"e":"must"},{"v":" không có "},{"e":"to"},{"v":"."}],"b":11,"start":80.434,"end":82.754},{"k":"e","sec":"mistakes","en":"She must be tired.","vi":"Chắc cô ấy mệt lắm.","ipa":["ʃi","mʌst","bi","ˈtaɪɚd"],"bad":{"en":"She must to be tired."},"b":11,"start":83.294,"end":84.344,"timing":[[0,83.294],[1,83.451],[2,83.739],[3,83.851]]},{"k":"n","sec":"mistakes","parts":[{"v":"Khả năng của một tình huống cụ thể: "},{"e":"could"},{"v":", "},{"e":"might"},{"v":", không dùng "},{"e":"can"},{"v":"."}],"b":12,"start":84.984,"end":89.724},{"k":"e","sec":"mistakes","en":"It could be Tom at the door.","vi":"Có thể là Tom ở ngoài cửa.","ipa":["ɪt","kʊd","bi","tɑm","æt","ðə","dɔɹ"],"bad":{"en":"It can be Tom at the door."},"b":12,"start":90.264,"end":91.674,"timing":[[0,90.264],[1,90.371],[2,90.571],[3,90.696],[4,91.046],[5,91.134],[6,91.246]]},{"k":"e","sec":"dialogue","en":"Someone is walking to the car. Is that Tom?","vi":"Có người đang đi ra xe kìa. Tom à?","ipa":["ˈsʌmˌwʌn","ɪz","ˈwɔkɪŋ","tu","ðə","kɑɹ","ɪz","ðæt","tɑm"],"who":"zoe","ann":{"gesture":"point"},"b":13,"start":92.814,"end":95.724,"timing":[[0,92.814],[1,93.127],[2,93.289],[3,93.702],[4,93.839],[5,93.964],[6,94.877],[7,95.002],[8,95.252]]},{"k":"e","sec":"dialogue","en":"It can't be Tom. He's much taller.","vi":"Không thể là Tom. Cậu ấy cao hơn nhiều.","ipa":["ɪt","kænt","bi","tɑm","hiz","mʌtʃ","ˈtɔlɚ"],"who":"sam","ann":{"expression":"thinking"},"b":13,"start":96.514